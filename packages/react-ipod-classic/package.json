{
  "name": "react-ipod-classic",
  "version": "0.1.0",
  "description": "A floating iPod Classic music player component for React applications.",
  "author": "Bernardo <https://github.com/gajonormal>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gajonormal/ipod-classic-revamped.git",
    "directory": "packages/react-ipod-classic"
  },
  "keywords": [
    "react",
    "ipod",
    "music-player",
    "floating-player",
    "retro",
    "component",
    "react-component"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "styled-components": ">=6.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.4",
    "ios-haptics": "^0.1.4",
    "motion": "^12.38.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "styled-components": "^6.4.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
