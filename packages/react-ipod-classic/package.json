{
  "name": "react-ipod-classic",
  "version": "0.1.0",
  "description": "A floating iPod Classic music player component for React applications.",
  "author": "Bernardo <https://github.com/gajonormal>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gajonormal/ipod-classic-revamped.git",
    "directory": "packages/react-ipod-classic"
  },
  "keywords": [
    "react",
    "ipod",
    "music-player",
    "floating-player",
    "retro",
    "component",
    "react-component"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "styled-components": ">=6.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.4",
    "he": "^1.2.0",
    "ios-haptics": "^0.1.4",
    "motion": "^12.38.0",
    "query-string": "^9.3.1",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/musickit-js": "^1.0.11",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/spotify-api": "^0.0.25",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@types/styled-components": "^5.1.36",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "styled-components": "^6.4.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}

